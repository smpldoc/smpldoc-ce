{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "smpldoc.bundle/1.0/card",
  "title": "card",
  "description": "The quick read: what the document is, in a few hundred bytes.",
  "type": "object",
  "properties": {
    "kind": {
      "enum": [
        "invoice",
        "bill",
        "receipt",
        "statement",
        "contract",
        "delivery-note",
        "purchase-order",
        "letter",
        "form",
        "document"
      ]
    },
    "category": {
      "enum": [
        "financial",
        "legal",
        "logistics",
        "identity",
        "correspondence",
        "other"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "parties": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "dates": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
      },
      "description": "name to YYYY-MM-DD, e.g. issued, due"
    },
    "totals": {
      "type": "object",
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^-?[0-9]{1,15}(\\.[0-9]{1,6})?$"
      },
      "description": "amounts as decimal strings, plus an ISO 4217 currency"
    },
    "pages": {
      "type": "integer",
      "minimum": 1
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
    },
    "summary": {
      "type": "string",
      "maxLength": 500
    },
    "tags": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "kind",
    "category",
    "title",
    "parties",
    "dates",
    "totals",
    "pages",
    "language",
    "summary",
    "tags"
  ]
}
