{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "smpldoc.bundle/1.0/manifest",
  "title": "manifest",
  "description": "What is in a bundle, where it came from, what read it, and a hash of every file.",
  "type": "object",
  "properties": {
    "format": {
      "const": "smpldoc.bundle"
    },
    "version": {
      "type": "string",
      "pattern": "^1\\.(0|[1-9][0-9]{0,2})$",
      "description": "MAJOR.MINOR"
    },
    "bundle_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "company": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "job_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "source": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "mail",
            "upload",
            "folder",
            "bucket"
          ]
        },
        "sender": {
          "type": "string",
          "maxLength": 320
        },
        "subject": {
          "type": "string",
          "maxLength": 998
        },
        "received_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "received_at"
      ]
    },
    "original": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 255
        },
        "content_type": {
          "enum": [
            "application/pdf",
            "image/tiff",
            "image/jpeg",
            "image/png",
            "text/plain"
          ]
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "content_type",
        "size",
        "sha256"
      ]
    },
    "engines": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "properties": {
          "step": {
            "enum": [
              "split",
              "pdf-text",
              "ocr",
              "layout",
              "fields",
              "card"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "version": {
            "type": "string",
            "maxLength": 64
          }
        },
        "additionalProperties": false,
        "required": [
          "step",
          "name",
          "version"
        ]
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "description": "every file except manifest.json and the original, by path, with its SHA-256"
    },
    "upgraded_from": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+$"
          },
          "at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
          },
          "how": {
            "enum": [
              "migrate",
              "reprocess"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "version",
          "at",
          "how"
        ]
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "bundle_id",
    "company",
    "job_id",
    "created_at",
    "source",
    "original",
    "engines",
    "files"
  ]
}
